# HG5585F（联通 10G-EPON 非对称）PON 预设
#
# 依据
#   * 原厂 /fh_tool/api GetDevInfo：current_ponmode = EPON_10G，asymmetric
#     → line mode 只能是 epon-10g-1g（不是 xgpon，也不是 epon-10g-10g）
#   * 原厂 GetDevInfo：port_num = 4 → ge_ports 必须写 4
#     （上游 airoha-ponctl 的默认值是 1，不改会少报 3 个以太口）
#   * OAM profile 默认 ctc：Issue #42 是同型号同线路的真机实测
#     （联通 / 非对称 10G-EPON / LOID 认证 / operator=ctc），
#     日志出现 "EPON LLID0 registered: LLID=0x...." 即注册成功。
#     若长时间不注册，A/B 到 ieee：
#       uci set pon.line0_oam.operator='ieee' && uci commit pon && /etc/init.d/pon reload
#
# 身份数据不预置（LOID / PON SN / MAC 都不写死）：
#   刷完在 LuCI → 网络 → PON → 配置 里填，或
#   uci set pon.line0_oam.loid='<你的LOID>' && uci commit pon && /etc/init.d/pon reload
#   板级数据（1 MiB factory 镜像）通过 网络 → PON → PON board data 上传。

config xpon 'line0'
	option device 'pon0'
	# option mode 'epon-10g-1g'
	# Accepts 16 raw hex digits or VEND followed by 8 hex digits.
	option serial_number ''
	# Accepts text:VALUE or hex: followed by 72 hex digits.
	option registration_id ''

config omci 'line0_omci'
	option line 'line0'
	option device 'omci0'
	option omcc_version '0xb0'
	option disable_enhanced_security '0'

	option vendor_id ''
	option equipment_id ''
	option hardware_version ''
	option software_version ''
	option operator_id ''
	option loid '1165127274'
	option loid_password ''

config oam 'line0_oam'
	option line 'line0'
	option device 'oam0'
	# ieee = 802.3ah；ctc = 802.3ah + CTC 扩展
	option operator 'ctc'
	option ctc_oui '111111'
	option ctc_versions '21 30'

	option vendor_id ''
	option model ''
	option equipment_id ''
	option hardware_version ''
	option software_version ''
	option firmware_version ''
	# 8-byte wire-order value encoded as 16 hex digits.
	option chipset_id ''
	option loid ''
	option loid_password ''
	# HG5585F 面板是 4 个以太口
	option ge_ports '4'
