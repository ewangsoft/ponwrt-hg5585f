#!/bin/sh
# /etc/uci-defaults/99-hg5585f-setup
#
# 首次启动执行一次（uci-defaults 机制会在脚本返回 0 后删除本文件）。
# 执行时机：/etc/init.d/boot (START=10) → uci_apply_defaults
#           → 早于 /etc/init.d/network (START=20)，所以改完 netifd 才起来。
#
# 模式：HG5585F = PPPoE 主路由（不是透明桥）
#   pon0.995  = 联通 INTERNET VLAN 995，PPPoE over VLAN
#   br-lan    = lan1..4（不含 pon0.995）
#   lan       = 192.168.31.1/24 + DHCP/RA
#   wan6      = DHCPv6（联通有 IPv6）
#
# 身份/账号不预置：
#   - LOID / PON 板级数据刷完在 LuCI 填
#   - PPPoE 账号密码刷完用 uci 或 LuCI 填（仓库是公开的，不能写进来）
#
# 撤销/改桥接：本脚本只跑一次；如需回退，见 README 的「桥接回退」。

LOG=/tmp/hg5585f-setup.log
: > "$LOG"
log() {
	echo "$*" >> "$LOG"
	logger -t hg5585f-setup "$*"
}

VLAN_INTERNET=21
VLAN_IPTV_u=23
VLAN_IPTV_m=99
LAN_ADDR=192.168.2.1
LAN_NETMASK=255.255.255.0
IPTV_ADDR=10.23.246.250
IPTV_NETMASK=255.255.248.0

# ---------------------------------------------------------------------------
# 1. 重建 network.device
#    br-lan 只含 lan2..4；pon0.21 只作为 WAN 的 802.1q 设备存在；pon0.23 只作为 iptv_vlan23 的 802.1q 设备存在；pon0.99 只作为 iptv_vlan99 的 802.1q 设备存在。
# ---------------------------------------------------------------------------
n=$(uci -q show network 2>/dev/null | grep -c '=device$')
while [ "$n" -gt 0 ]; do
	uci -q delete network.@device[0]
	n=$((n - 1))
done

uci -q batch <<EOF
set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
# add_list network.br_lan.ports='lan1'
add_list network.br_lan.ports='lan2'
add_list network.br_lan.ports='lan3'
add_list network.br_lan.ports='lan4'

set network.pon0_${VLAN_INTERNET}='device'
set network.pon0_${VLAN_INTERNET}.name='pon0.${VLAN_INTERNET}'
set network.pon0_${VLAN_INTERNET}.type='8021q'
set network.pon0_${VLAN_INTERNET}.ifname='pon0'
set network.pon0_${VLAN_INTERNET}.vid='${VLAN_INTERNET}'

set network.pon0_${VLAN_IPTV_u}='device'
set network.pon0_${VLAN_IPTV_u}.name='pon0.${VLAN_IPTV_u}'
set network.pon0_${VLAN_IPTV_u}.type='8021q'
set network.pon0_${VLAN_IPTV_u}.ifname='pon0'
set network.pon0_${VLAN_IPTV_u}.vid='${VLAN_IPTV_u}'

set network.pon0_${VLAN_IPTV_m}='device'
set network.pon0_${VLAN_IPTV_m}.name='pon0.${VLAN_IPTV_m}'
set network.pon0_${VLAN_IPTV_m}.type='8021q'
set network.pon0_${VLAN_IPTV_m}.ifname='pon0'
set network.pon0_${VLAN_IPTV_m}.vid='${VLAN_IPTV_m}'
EOF

# ---------------------------------------------------------------------------
# 2. lan：静态管理地址 + 下游 DHCP/RA
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='${LAN_ADDR}'
set network.lan.netmask='${LAN_NETMASK}'
set network.lan.delegate='1'
set network.lan.ipv6='1'
set network.lan.ip6assign='60'
set network.lan.peerdns='0'
delete network.lan.gateway
delete network.lan.dns
delete network.lan.ifname
delete network.lan.ip6hint
delete network.lan.ip6ifaceid
delete network.lan.ip6class
delete network.lan.ip6prefix
EOF

# ---------------------------------------------------------------------------
# 3. wan：联通 PPPoE over VLAN 21
#    账号密码刻意留空，刷完填：
#      uci set network.wan.username='...'
#      uci set network.wan.password='...'
#      uci commit network && /etc/init.d/network restart
#
#    MTU=1500 而非 1492（2026-10-22 审计 §E.4/Q5）：netifd 把 wan.mtu 同时
#    下发给 pon0.995 设备和 pppd，1492 被双重扣减 → pppoe-wan 实际 1484 /
#    MSS 1444。设 1500 → pppd 扣 8 字节 PPPoE 头 → pppoe-wan=1492 /
#    MSS=1452（标准值）；fw4 的 MSS clamp 自动跟随。PMTU 黑洞由
#    tcp_mtu_probing=1 兜底（files/etc/sysctl.d/99-network-tuning.conf）。
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.wan='interface'
set network.wan.device='pon0.${VLAN_INTERNET}'
set network.wan.proto='pppoe'
set network.wan.ipv6='1'
set network.wan.auto='1'
set network.wan.peerdns='1'
set network.wan.mtu='1500'
set network.wan.mru='1500'
set network.wan.keepalive='5 5'
delete network.wan.username
delete network.wan.password
delete network.wan.hostname
delete network.wan.metric
EOF

# ---------------------------------------------------------------------------
# 4. wan6：PPPoE 上的 DHCPv6（联通 IPv6）
# ---------------------------------------------------------------------------
uci -q delete network.wan6
uci -q batch <<EOF
set network.wan6='interface'
set network.wan6.device='@wan'
set network.wan6.proto='dhcpv6'
set network.wan6.reqaddress='try'
set network.wan6.reqprefix='auto'
set network.wan6.peerdns='1'
set network.wan6.auto='1'
EOF

# ---------------------------------------------------------------------------
# 2. wan2：DHCP + 第二出口
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.wan2='interface'
set network.wan2.device='lan1'
set network.wan2.proto='dhcp'

set network.wan62='interface'
set network.wan62.device='lan1'
set network.wan62.proto='dhcpv6'
set network.wan62.norelease='1'
EOF

# ---------------------------------------------------------------------------
# IPTV单播接口配置
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.iptv_vlan${VLAN_IPTV_u}='interface'
set network.iptv_vlan${VLAN_IPTV_u}.device='pon0.${VLAN_IPTV_u}'
set network.iptv_vlan${VLAN_IPTV_u}.proto='static'
set network.iptv_vlan${VLAN_IPTV_u}.device='pon0.${VLAN_IPTV_u}'
set network.iptv_vlan${VLAN_IPTV_u}.ipaddr='${IPTV_ADDR}'
set network.iptv_vlan${VLAN_IPTV_u}.netmask='${IPTV_NETMASK}'
EOF

# ---------------------------------------------------------------------------
# IPTV组播接口配置
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.iptv_vlan${VLAN_IPTV_m}='interface'
set network.iptv_vlan${VLAN_IPTV_m}.device='pon0.${VLAN_IPTV_m}'
EOF

# ---------------------------------------------------------------------------
# 配置IPTV防火墙区域
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set firewall.iptv='zone'
set firewall.iptv.name='iptv'
set firewall.iptv.input='DROP'
set firewall.iptv.output='ACCEPT'
set firewall.iptv.forward='DROP'
set firewall.iptv.masq='1'
add_list firewall.iptv.network='iptv_vlan${VLAN_IPTV_u}'
add_list firewall.iptv.network='iptv_vlan${VLAN_IPTV_m}'
set firewall.iptv_fwd='forwarding'
set firewall.iptv_fwd.src='lan'
set firewall.iptv_fwd.dest='iptv'
EOF

# ---------------------------------------------------------------------------
# wan2添加到wan防火墙区域
# ---------------------------------------------------------------------------
WAN_index=$(uci show firewall | grep "name='wan'" | sed -n 's/firewall\.@zone\[\([0-9]*\)\]\.name='\''wan'\''/\1/p' | head -n1)
uci -q add_list firewall.@zone[${WAN_index}].network='wan2'
uci -q add_list firewall.@zone[${WAN_index}].network='wan62'

# ---------------------------------------------------------------------------
# 5. DHCP / RA：现在是主路由，必须开
#    静态租约（平板/小米 AP）在 files/etc/config/dhcp 里，脚本不覆盖。
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set dhcp.lan.ignore='0'
set dhcp.lan.dhcpv4='server'
set dhcp.lan.dhcpv6='server'
set dhcp.lan.ra='server'
set dhcp.lan.ndp='disabled'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.lan.ra_slaac='1'
delete dhcp.lan.ra_flags
add_list dhcp.lan.ra_flags='managed-config'
add_list dhcp.lan.ra_flags='other-config'
set dhcp.wan.ignore='1'
EOF

# ---------------------------------------------------------------------------
# 6. flow offload —— 按代理栈分支（软件卸载恒开；硬件 PPE 卸载看栈而定）
#
#    ===== 先分清两种卸载，这是本节最容易被误读的地方 =====
#    · 软件 flowtable 卸载（flow_offloading=1，fw4 的 nft flowtable）
#        → 发生在 **forward 链**。dae/TPROXY 这类代理在更早的钩子就把包
#          「本地投递」掉了（见下），被代理的流根本走不到 forward，
#          所以 software offload 对代理流量天然安全。→ 恒开。
#    · 硬件 PPE 卸载（flow_offloading_hw=1，Airoha 包处理器）
#        → 已建立的流转交专用硬件转发、**不再回 CPU**。
#          凡是需要 CPU 上任何钩子的处理（eBPF/TC/Netfilter）都会失去介入机会。
#
#    ===== 为什么「tproxy 不受 PPE 影响」不能直接套到 dae 上 =====
#    2026-10-20 的实测（8 路并发，PC 有线千兆）证明的是 **TPROXY** 场景：
#      · 直连下行 ~670 Mbps 时四核合计 busy 仅 ~4%  → PPE 确实在卸载
#      · 开 hw 前后代理出口 IP 不变（155.254.108.53），YouTube 204 正常
#      · npu_attached: 1，/sys/kernel/debug/ppe/entries 有 BND/UNB 表项
#    这条证据链只覆盖 Passwall/OpenClash（TPROXY 路径），**没有覆盖 dae**。
#
#    补充事实（dae 源码 control/kern/tproxy.c）：dae 与被代理连接同样走
#    `bpf_sk_assign()` 做本地投递，钩子在 `tc/lan_ingress` —— 也就是说
#    dae 的**代理流量**在架构上与 TPROXY 同类，同样进不了 forward/flowtable，
#    理论上 PPE 也看不到它。
#
#    但「理论上看不到」≠「已验证安全」，所以 dae 变体先取保守值 hw=0：
#      1) dae 在 TC 层还有 wan_ingress/wan_egress 等多个钩子（源码共 12 处
#         tc/* 程序），其命中范围是否都被 sk_assign 挡在 forward 之前，
#         未在 an7581 + PPE 上实测过；
#      2) 本项目历史上（旧 LibWrt 时代）留有"不要开 flow_offloading_hw
#         （可能与 dae 的 eBPF 冲突）"的告警，从未被证伪；
#      3) A/B 对照需要干净变量，先关是更可控的起点。
#
#    => 装了 dae        → flow_offloading=1 + flow_offloading_hw=0（保守，待实测）
#    => 没装 dae        → flow_offloading=1 + flow_offloading_hw=1（保留原实测证据链）
#
#    回浏览器/实测一键回退到 hw=1（做 A/B 的 B 轮时用）：
#      uci set firewall.@defaults[0].flow_offloading_hw='1' && \
#      uci commit firewall && /etc/init.d/firewall reload
#
#    判据（实测 hw=1 是否安全）：15 min 内对照①代理出口 IP 是否仍等于节点 IP
#    ②dae 规则命中是否正常 ③/sys/kernel/debug/ppe/entries 行数
#    ④/proc/net/softnet_stat 的 dropped ⑤直连吞吐。
#    若 hw=1 下规则失效 → 本变体固化为 hw=0。
# ---------------------------------------------------------------------------
#
# 运行时探测（不是构建期注入标记）：镜像里 /usr/bin/dae 存在即 dae 变体。
if [ -x /usr/bin/dae ]; then
	FLOW_HW=0
	FLOW_REASON="检测到 dae（${FLOW_HW} = 保守值，PPE 与 TC/eBPF 的交互未经 an7581 实测）"
else
	FLOW_HW=1
	FLOW_REASON="未装 dae（维持 2026-10-20 tproxy 实测结论：PPE 不影响 tproxy）"
fi
uci -q batch <<EOF
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='${FLOW_HW}'
EOF
log "flow_offloading=1 / flow_offloading_hw=${FLOW_HW}（${FLOW_REASON}）"

# ---------------------------------------------------------------------------
# 6b. packet_steering —— 必须设 2（RPS-only）
#
#    OpenWrt 的 /usr/libexec/network/packet-steering.uc 按 **netdev 名** 匹配
#    NAPI 线程；airoha 的以太网 NAPI 线程叫 napi/qdma_eth-0，netdev 却叫 pon0，
#    名字对不上 → 脚本判定"无 NAPI 可绑"，把 32 条 RX 队列的 RPS 全塌到 CPU0。
#    设成 2（纯 RPS，不做每核队列）可绕开该匹配逻辑，rps_cpus 恢复为 f（四核）。
#    实测：NET_RX 软中断从 CPU0 分散到 CPU1/2/3，IPI1 计数在三个从核上显著增长。
# ---------------------------------------------------------------------------
uci -q set network.globals.packet_steering='2'

# ---------------------------------------------------------------------------
# 6c. 启用随包附带的两个绑核服务
#
#   irq-affinity       ：把 airoha_eth 的大中断（irq23/27）从 CPU0 挪到 CPU1/CPU2。
#                        mt7915e 的 irq19/53 内核禁止用户态改，保持 CPU0。
#   wifi-napi-affinity ：把 mt76 的 6 个 napi/phy0-N 线程钉到 CPU3
#                        （单芯片双频，phy0/phy1 共用同一组 NAPI 线程）。
#
#   两者都只是**负载分布**优化，实测对峰值吞吐无影响（678 vs 673 Mbps）。
#   代码与说明见 files/etc/init.d/ 下同名脚本。
# ---------------------------------------------------------------------------
for svc in irq-affinity wifi-napi-affinity; do
	if [ -x "/etc/init.d/$svc" ]; then
		"/etc/init.d/$svc" enable >/dev/null 2>&1
		"/etc/init.d/$svc" start  >/dev/null 2>&1 &
		log "已启用 $svc"
	fi
done

# ---------------------------------------------------------------------------
# 6d. RPS 队列深度
#
#    packet_steering=2 把 32 条 RX 队列的 rps_cpus 设为 f（四核均可收），
#    RPS 靠 IPI 把包投到目标核；默认 backlog 1000 在 700Mbps 多流下偏浅，
#    目标核来不及消费就整包丢弃（实测 softnet cpu0 dropped 累计 4356）。
#    注意：/etc/sysctl.d/ 下的文件若由镜像自带，这里的追加是幂等的。
# ---------------------------------------------------------------------------
if [ -f /etc/sysctl.d/99-network-tuning.conf ] &&
   ! grep -q 'netdev_max_backlog' /etc/sysctl.d/99-network-tuning.conf; then
	cat >> /etc/sysctl.d/99-network-tuning.conf <<'EOF'

# --- RPS 排队深度 ---
net.core.netdev_max_backlog=16384
EOF
fi
sysctl -w net.core.netdev_max_backlog=16384 >/dev/null 2>&1

# ---------------------------------------------------------------------------
# 7. WiFi 默认关闭（小米 BE6500 Pro 继续做 AP）
# ---------------------------------------------------------------------------
if [ -x /sbin/wifi ]; then
	/sbin/wifi config >/dev/null 2>&1
	for r in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		uci -q set "wireless.$r.disabled='1'"
	done
	uci -q commit wireless
fi

# ---------------------------------------------------------------------------
# 8. 时间同步与时区
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set system.ntp='timeserver'
set system.ntp.enabled='1'
set system.ntp.enable_server='0'
delete system.ntp.server
add_list system.ntp.server='ntp.aliyun.com'
add_list system.ntp.server='ntp.tencent.com'
add_list system.ntp.server='cn.pool.ntp.org'
EOF

uci set luci.main.mediaurlbase='/luci-static/bootstrap'

uci -q commit network
uci -q commit dhcp
uci -q commit firewall
uci -q commit system
uci -q commit luci
# ---------------------------------------------------------------------------
# 9. 自检
# ---------------------------------------------------------------------------
if [ "$(uci -q get network.wan.device)" = "pon0.${VLAN_INTERNET}" ] &&
   [ "$(uci -q get network.wan.proto)" = "pppoe" ]; then
	log "OK: wan = pon0.${VLAN_INTERNET} / pppoe / mtu $(uci -q get network.wan.mtu)"
else
	log "ERROR: wan 没有配置成 pon0.${VLAN_INTERNET}/pppoe"
fi

if uci -q get network.br_lan.ports | grep -qw 'pon0.${VLAN_INTERNET}'; then
	log "ERROR: br-lan 里仍含 pon0.${VLAN_INTERNET}，桥接会再次把 LAN 放进运营商二层"
else
	log "OK: br-lan 成员 = $(uci -q get network.br_lan.ports | tr '\n' ' ')"
fi

if [ "$(uci -q get dhcp.lan.ignore)" = "0" ]; then
	log "OK: lan DHCP/RA 已开启（192.168.2.0/24）"
else
	log "ERROR: dhcp.lan.ignore 不是 0，下游拿不到地址"
fi

if [ -x /usr/bin/dae ]; then
	log "OK: flow_offloading=$(uci -q get firewall.@defaults[0].flow_offloading) hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)（dae 变体，hw 期望为 0）"
else
	log "OK: flow_offloading=$(uci -q get firewall.@defaults[0].flow_offloading) hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
fi
[ -n "$(uci -q get network.wan.username)" ] || log "待办：network.wan.username/password（PPPoE 账号）"
[ -n "$(uci -q get pon.line0_oam.loid)" ] || log "待办：pon.line0_oam.loid（LOID）"
log "待办：上传 PON board data（1 MiB factory 镜像）"
log "WiFi 默认关闭；小米 AP 继续做无线接入"

exit 0
