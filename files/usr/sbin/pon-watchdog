#!/bin/sh
# pon-watchdog —— 10G-EPON 冷启动 MPCP 自循环的兜底（上游 Issue #42）
#
# 现象（Issue #42 实测现场，与 HG5585F 联通非对称 10G-EPON 同驱动）：
#   注册成功后 ~1s 就 MPCP timeout，然后重新注册，循环；光层完全健康。
#   关键字段：
#     lifecycle: operational          ← 不是 wait-line-sync/error
#     optical_signal: 1
#     service_ready: 0                ← 唯一直接反映"没真正上线"
#     mpcp_state: 4 (registered)
#     mpcp_timeouts: 1 Hz 增长
#     registered_lifetime_ms: 600~950
#   也就是说：只看 lifecycle 会以为是好的；rx_start_count 在 MPCP timeout 路径
#   根本不自增（只有 epon_start_rx 两个分支自增），不能当判据。
#
# 判据（本版）：
#   - lifecycle=operational && service_ready=1  -> 健康
#   - operational && service_ready=0 && registration/mpcp_timeouts 持续增长
#     -> 判定卡死（未配置 LOID 时 mpcp_timeouts 不会涨，不会误触发）
#   - wait-line-sync / error                    -> 直接判热
#   - protocol-activating + mpcp_timeouts 增长  -> 判热
#
# 恢复（主路由模式）：
#   只拆 WAN：ifdown wan → 删 pon0.995 → 卸/装 airoha_xpon → pon reload →
#   pond start → ip link set pon0 up → ifup wan。
#   绝不 ifdown lan —— LAN 是管理面，也是下游 AP/PC 的出口。
#
# 手动排障：
#   logread -e pon-watchdog
#   cat /tmp/pon-watchdog.log
#   cat /sys/kernel/debug/airoha-xpon-pon0/line
#   cat /sys/kernel/debug/airoha-xpon-pon0/registration
#   停用：/etc/init.d/pon-watchdog stop && /etc/init.d/pon-watchdog disable

DBG_LINE=/sys/kernel/debug/airoha-xpon-pon0/line
DBG_REG=/sys/kernel/debug/airoha-xpon-pon0/registration
LOGFILE=/tmp/pon-watchdog.log

POLL=10          # 采样周期（秒）
GRACE=120        # 开机宽限期
NEED=4           # 连续异常采样次数（4 × 10s = 40s）
MPCP_HOT=3       # 单个采样窗口内 mpcp_timeouts 增量阈值（≈1Hz 自循环）
RX_HOT=20        # 兼容旧形态：rx_start_count 大量增长
MAXTRY=3         # 连续恢复失败次数上限
BACKOFF=600      # 达到上限后的退避时长（秒）

log() {
	logger -t pon-watchdog "$*"
	printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOGFILE"
	if [ "$(wc -l < "$LOGFILE" 2>/dev/null || echo 0)" -gt 400 ]; then
		tail -n 200 "$LOGFILE" > "$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
	fi
}

is_true() {
	case "$1" in
		1|y|Y|yes|on|true|True|up) return 0 ;;
	esac
	return 1
}

num_or_zero() {
	case "$1" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

read_field() {
	local file="$1" key="$2"
	[ -r "$file" ] || return 1
	awk -v k="$key" '$1 == k ":" { print $2; exit } $1 == k { print $2; exit }' "$file" 2>/dev/null
}

recover() {
	log "recover: 开始（只拆 WAN，保留 LAN/管理面）"

	ifdown wan >/dev/null 2>&1 || true
	# ip link set pon0.995 down 2>/dev/null
	# ip link del pon0.995 2>/dev/null
    for i in $(ip -o link show | awk -F': ' '{print $2}' | grep '^pon0\.'); do
    	ip link set "$i" down 2>/dev/null
    	ip link del "$i" 2>/dev/null
	done
	ip link set pon0 down 2>/dev/null
	/etc/init.d/airoha-pond stop >/dev/null 2>&1

	i=0
	while [ "$i" -lt 3 ]; do
		modprobe -r airoha_xpon >/dev/null 2>&1 && break
		i=$((i + 1))
		sleep 2
	done

	if [ -d /sys/module/airoha_xpon ]; then
		log "recover: ERROR airoha_xpon 卸载失败（pon0.995/pond 仍有引用），本次恢复无效"
		ifup wan >/dev/null 2>&1 || true
		return 1
	fi

	if modprobe airoha_xpon >/dev/null 2>&1 && [ -d /sys/module/airoha_xpon ]; then
		log "recover: airoha_xpon 已重新加载"
	else
		log "recover: ERROR airoha_xpon 加载失败"
		ifup wan >/dev/null 2>&1 || true
		return 1
	fi
	sleep 2

	/etc/init.d/pon reload >/dev/null 2>&1
	/etc/init.d/airoha-pond start >/dev/null 2>&1
	ip link set pon0 up 2>/dev/null
	ifup wan >/dev/null 2>&1 || log "recover: WARN ifup wan 失败，稍后重试"

	if ip -4 addr show dev br-lan 2>/dev/null | grep -q 'inet '; then
		log "recover: 结束（WAN 已重建，LAN 未受影响）"
	else
		log "recover: WARN br-lan 没有 IPv4 地址，请检查 /etc/config/network"
	fi
	return 0
}

cnt=0
prev_rx=
prev_to=
tries=0
last_state=
debugfs_tried=0

log "启动：poll=${POLL}s grace=${GRACE}s need=${NEED} mpcp_hot=${MPCP_HOT}"

while :; do
	sleep "$POLL"

	if [ "$(cut -d. -f1 /proc/uptime)" -lt "$GRACE" ]; then
		continue
	fi

	if [ ! -r "$DBG_LINE" ] || [ ! -r "$DBG_REG" ]; then
		if [ "$debugfs_tried" != 1 ]; then
			mount -t debugfs none /sys/kernel/debug 2>/dev/null
			debugfs_tried=1
		fi
		if [ ! -r "$DBG_LINE" ] || [ ! -r "$DBG_REG" ]; then
			log "WARN: $DBG_LINE 或 $DBG_REG 不可读（pon0 未创建/debugfs 未挂载），30s 后重试"
			sleep 30
			continue
		fi
	fi

	life=$(read_field "$DBG_LINE" lifecycle)
	opt=$(read_field "$DBG_LINE" optical_signal)
	sr=$(read_field "$DBG_LINE" service_ready)
	rx=$(num_or_zero "$(read_field "$DBG_LINE" rx_start_count)")
	to=$(num_or_zero "$(read_field "$DBG_REG" mpcp_timeouts)")
	req=$(num_or_zero "$(read_field "$DBG_REG" register_requests)")
	life_ms=$(num_or_zero "$(read_field "$DBG_REG" registered_lifetime_ms)")

	state="$life/$opt/$sr/to=$to/rx=$rx/life_ms=$life_ms"
	if [ "$state" != "$last_state" ]; then
		log "state: lifecycle=$life optical_signal=$opt service_ready=$sr mpcp_timeouts=$to register_requests=$req rx_start_count=$rx registered_lifetime_ms=$life_ms"
		last_state="$state"
	fi

	# 健康：清零所有计数
	if [ "$life" = "operational" ] && is_true "$sr"; then
		[ "$cnt" != 0 ] && log "已恢复健康"
		cnt=0
		tries=0
		prev_rx=$rx
		prev_to=$to
		continue
	fi

	# 光层不通：看门狗不介入，只留 state 日志
	if ! is_true "$opt"; then
		cnt=0
		prev_rx=$rx
		prev_to=$to
		continue
	fi

	dto=$((to - ${prev_to:-$to}))
	delta=$((rx - ${prev_rx:-$rx}))
	[ "$dto" -lt 0 ] && dto=0
	[ "$delta" -lt 0 ] && delta=0
	prev_rx=$rx
	prev_to=$to
	cnt=$((cnt + 1))

	hot=0
	case "$life" in
	wait-line-sync|error)
		hot=1
		;;
	protocol-activating)
		# 正常注册会在这里停留 10-30s；只有 MPCP 超时/重注册狂涨才算异常
		{ [ "$dto" -ge "$MPCP_HOT" ] || [ "$delta" -ge "$RX_HOT" ]; } && hot=1
		;;
	operational)
		# Issue #42 形态：lifecycle 说 operational，但 service_ready=0，
		# 且 mpcp_timeouts 每秒增长。未填 LOID 时 mpcp_timeouts 为 0，不会误触发。
		if ! is_true "$sr" && [ "$dto" -ge "$MPCP_HOT" ]; then
			hot=1
		fi
		;;
	esac

	[ "$cnt" -ge "$NEED" ] && [ "$hot" = 1 ] || continue

	log "判定卡死：lifecycle=$life service_ready=$sr mpcp_delta=${dto}/${POLL}s rx_delta=${delta} registered_lifetime_ms=$life_ms"
	recover
	cnt=0
	prev_rx=
	prev_to=
	tries=$((tries + 1))

	if [ "$tries" -ge "$MAXTRY" ]; then
		log "连续 ${tries} 次恢复后仍不健康，退避 ${BACKOFF}s（不重启设备）"
		sleep "$BACKOFF"
		tries=0
	fi
done
