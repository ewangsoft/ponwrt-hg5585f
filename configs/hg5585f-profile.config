# ---------------------------------------------------------------------------
# HG5585F 专用 profile 层（叠加在 configs/an7581.config + configs/release.config 之上）
#
# 目的：把上游默认启用的 12 个 an7581 device profile 收敛到 1 个
#       —— fiberhome_hg5585f-cu
#
# 依据：
#   * MULTI_PROFILE=y + PER_DEVICE_ROOTFS=y 时，每个 device 独立链接内核 + 独立打包 rootfs，
#     12 个里有 10 个是纯浪费（约 40-60 分钟 CI 时间）
#   * 只编 usb-sfp 之外的型号不影响刷机：Device/fiberhome_hg5585f-{ct,cu} 的
#     SUPPORTED_DEVICES 已互相包含 *-usb-sfp，sysupgrade 不会因设备名不匹配而拒绝
#
# 注意：本文件必须放在 kconfig.pl 链式的**最后一步**才能生效
#       （scripts/kconfig.pl 的 `+` 是后者无条件覆盖前者，含 "# ... is not set"）
# ---------------------------------------------------------------------------

# ---- 必须保留：多 profile 机制本身 ----
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# CONFIG_TARGET_ALL_PROFILES is not set

# ---- 必须保留：一台机器的 profile ----
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=""
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct is not set
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7581_DEVICE_fiberhome_hg5585f-ct is not set

# ---- 关掉其余 10 个 device ----
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5382a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xg2010g is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi-usb-sfp is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_nokia_xg-040g-tf-ubi is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_unionman_ung00a is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn504xg-d is not set
# CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_znxt_zn515xg-d is not set

# ---- 其余子目标不参与 ----
# CONFIG_TARGET_airoha_an7583 is not set
# CONFIG_TARGET_airoha_en7523 is not set
