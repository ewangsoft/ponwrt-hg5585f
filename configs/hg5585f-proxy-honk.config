# ---------------------------------------------------------------------------
# 分流层 D：honk（eBPF 透明代理，dae 的新内核）
#
# 由 gen-config.sh 按 PROXY=honk 追加到 kconfig 链最后一步（在 build 层之后），
# 所以这里的每一项都能覆盖前面的层。
#
# 与 dae 层的关系：
#   - honk 和 dae 都会创建 dae0 链路对与 daens 命名空间，只能二选一；
#   - `package/honk` 使用官方 v0.1.0-beta.3 aarch64 musl stock-full 预编译包，
#     不在固件构建里拉 Rust/nightly/bpf-linker；
#   - BTF 仍由内核自带（CONFIG_DEBUG_INFO_BTF=y），vmlinux-btf-builtin 只负责
#     满足 honk 的 +vmlinux-btf 虚依赖。
#
# 硬前提：
#   1) Linux >= 6.12（honk 启动硬检查；ponwrt 6.18 满足）
#   2) 内核 BTF（/sys/kernel/btf/vmlinux）
#   3) TCX：CONFIG_NET_XGRESS（target/linux/airoha/an7581/config-6.18 已开）
#   4) cgroup2 + CONFIG_CGROUP_BPF
#   5) NFQUEUE 320：kmod-nft-queue + kmod-nfnetlink-queue
# ---------------------------------------------------------------------------

# ---- 1. 内核 BTF（honk 的 CO-RE 硬前提）----
# an7581.config:310 把 REDUCED 打开了；BTF 依赖 !REDUCED，必须关掉它
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# ---- 2. eBPF / TC / cgroup（honk 数据面）----
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_KPROBES=y
# netkit（>=6.7 才有；6.18 满足。honk 不支持时回退 veth）
CONFIG_KERNEL_NETKIT=y

# ---- 3. honk 本体 + 面板 + 地理数据 ----
CONFIG_PACKAGE_honk=y
# PonWrt 内核自带 BTF，不需要外部 vmlinux-btf blob；空包提供虚依赖
CONFIG_PACKAGE_vmlinux-btf-builtin=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_ca-bundle=y

# ---- 3b. TC / NFQUEUE / veth 依赖 ----
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# ---- 4. 明确排除其它代理栈（"只保留一种"）----
# dae 与 honk 冲突（dae0/daens）；本层不选 dae 包。
# CONFIG_PACKAGE_dae is not set
# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_luci-i18n-dae-zh-cn is not set

# CONFIG_PACKAGE_luci-app-passwall is not set
# 上游 an7581.config 把 passwall 的一堆 INCLUDE_* 设成了 y。虽然 passwall 本体已关，
# 这些子符号不会真的拉包，但显式清掉可避免 defconfig 求解顺序把依赖带回来。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_sing-box-tiny is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_trojan is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_3proxy is not set
# CONFIG_PACKAGE_brook is not set
# CONFIG_PACKAGE_tuic-client is not set
